        "id": 1002484
      },
      "writtenOn": "2026-08-18T06:42:53Z",
      "side": 1,
      "message": "getPowerState() defaults to Always and silently ignores unknown strings, so a typo would start the sensor earlier than before. It now parses the property locally, logs an error on an unrecognised value, and falls back to On — the behaviour prior to this change.",
      "parentUuid": "54907330_78d484aa",
      "revId": "46841e23c94cafc955c16916a31c55ca77686cab",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
